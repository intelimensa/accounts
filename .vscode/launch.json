{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Launch Intelimensa.Accounts (web)",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build",
            "program": "${workspaceFolder}/Intelimensa.Accounts/bin/Debug/net10.0/Intelimensa.Accounts.dll",
            "args": [],
            "cwd": "${workspaceFolder}/Intelimensa.Accounts",
            "stopAtEntry": false,
            "launchSettingsFilePath": "${workspaceFolder}/Intelimensa.Accounts/Properties/launchSettings.json",
            "launchSettingsProfile": "https",
            "env": {
                "ASPNETCORE_ENVIRONMENT": "Development"
            },
            "serverReadyAction": {
                "action": "openExternally",
                "pattern": "\\bNow listening on:\\s+(https?://\\S+)"
            }
        },
        {
            "name": ".NET Core Attach",
            "type": "coreclr",
            "request": "attach"
        }
    ]
}
