      "replyHex": "000c4d53563347303030303031380a4d4e5051525354565758",
      "expect": {
        "valid": true,
        "serial": "MSV3G0000018",
        "code": "MNPQRSTVWX"
      }
    },
    {
      "name": "code-alphabet-3",
      "note": "",
