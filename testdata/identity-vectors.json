      "replyHex": "00204d5356334730315341544b582122232425262728292a2b2c2d2e2f30313233340a41424344454647484a4b",
      "expect": {
        "valid": true,
        "serial": "MSV3G01SATKX!\"#$%&'()*+,-./01234",
        "code": "ABCDEFGHJK"
      }
    },
