{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=accounts.db"
  },
  "Releases": {
    "StoragePath": "releases"
  },
  "Jwt": {
    "Issuer": "Intelimensa.Accounts",
    "Audience": "Intelimensa.AxoSync",
    "AccessTokenLifetimeMinutes": 15,
    "RefreshTokenLifetimeDays": 30
  }
}
