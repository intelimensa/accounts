@page
@model Intelimensa.Accounts.Pages.Admin.RolesModel
@{
    ViewData["Title"] = "Admin: Roles";
}

<h1 class="h3 mb-3">Roles</h1>
<p class="text-muted">
    Participant access isn't a role: staff approve accounts on the Staff page. Administrators are
    granted only with <code>scripts/setrole.sh</code>. A role change ends that user's web
    sessions immediately; API tokens already issued keep their roles until they expire.
</p>

@if (Model.StatusMessage is not null)
{
    <div class="alert alert-success" role="alert">@Model.StatusMessage</div>
}
@if (Model.ErrorMessage is not null)
{
    <div class="alert alert-danger" role="alert">@Model.ErrorMessage</div>
}

<div class="d-flex flex-column gap-2">
    @foreach (var user in Model.Users)
    {
        <div class="feature-card d-flex flex-wrap align-items-center gap-3">
            <div class="flex-grow-1" style="min-width: 14rem;">
                <strong>@user.Email</strong>
                @if (user.Roles.Contains("Administrator"))
                {
                    <span class="badge text-bg-secondary ms-1">Administrator</span>
                }
            </div>
            @foreach (var role in Intelimensa.Accounts.Pages.Admin.RolesModel.Grantable)
            {
                var has = user.Roles.Contains(role);
                <form method="post" asp-page-handler="Set">
                    <input type="hidden" name="userId" value="@user.Id" />
                    <input type="hidden" name="role" value="@role" />
                    <input type="hidden" name="enabled" value="@((!has).ToString().ToLowerInvariant())" />
                    <button type="submit" class="btn btn-sm @(has ? "btn-ia-primary" : "btn-outline-secondary")">
                        @role: @(has ? "on" : "off")
                    </button>
                </form>
            }
        </div>
    }
</div>
