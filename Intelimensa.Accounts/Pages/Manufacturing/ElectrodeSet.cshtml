@page "{id:guid}"
@model Intelimensa.Accounts.Pages.Manufacturing.ElectrodeSetModel
@using Intelimensa.Accounts.Manufacturing
@using Intelimensa.Accounts.Pages.Manufacturing
@{
    ViewData["Title"] = "Manufacturing: Electrode set";
    const int Nm = ElectrodeSetService.MaxNameLength;
    const int Vr = ElectrodeSetService.MaxVersionLength;
    const int Pn = ElectrodeSetService.MaxPartNumberLength;
    const int Ds = ElectrodeSetService.MaxLineDescriptionLength;
}

<h1 class="h3 mb-3">Electrode set</h1>
<partial name="_ProductionMessages" model="Model" />

@if (Model.Set is null)
{
    <p class="text-muted">No such electrode set.</p>
}
else
{
    var set = Model.Set;
    <div class="feature-card mb-3">
        <div class="d-flex flex-wrap gap-2 align-items-baseline mb-2">
            <span class="h5 mb-0">@set.Name @set.Version</span>
            @if (set.RetiredAt is not null) { <span class="badge text-bg-secondary">retired</span> }
            @if (set.FrozenAt is not null) { <span class="badge text-bg-info">frozen</span> }
            <span class="text-muted small">@Model.Units unit(s) carry this set</span>
        </div>
        <p class="small text-muted mb-2">
            Last modified @ProductionPageModel.When(set.LastModifiedAt) by @ProductionPageModel.Who(Model.Emails, set.LastModifiedByUserId).
            Created by @ProductionPageModel.Who(Model.Emails, set.CreatedByUserId).
            @if (set.PreviousId is not null) { <span>A revision of <a asp-page="/Manufacturing/ElectrodeSet" asp-route-id="@set.PreviousId">an earlier set</a>.</span> }
        </p>

        @if (Model.Editable)
        {
            <form method="post" asp-page-handler="Save" asp-route-id="@set.Id" class="row g-2">
                <div class="col-sm-5">
                    <label class="form-label small" for="h-name">Name</label>
                    <input id="h-name" name="name" value="@set.Name" class="form-control" maxlength="@Nm" required />
                </div>
                <div class="col-sm-3">
                    <label class="form-label small" for="h-version">Version</label>
                    <input id="h-version" name="version" value="@set.Version" class="form-control" maxlength="@Vr" required />
                </div>
                <div class="col-12">
                    <label class="form-label small" for="h-desc">Description</label>
                    <input id="h-desc" name="description" value="@set.Description" class="form-control" maxlength="@ElectrodeSetService.MaxSetDescriptionLength" />
                </div>
                <div class="col-12"><button type="submit" class="btn btn-ia-outline btn-sm">Save</button></div>
            </form>
        }
        else
        {
            @if (set.Description is not null) { <p class="mb-2">@set.Description</p> }
            @if (set.RetiredAt is null)
            {
                <p class="small text-muted mb-2">This set was assigned to a unit and is frozen. Make a new revision to change it.</p>
            }
        }

        <div class="d-flex flex-wrap gap-3 mt-2">
            <form method="post" asp-page-handler="NewRevision" asp-route-id="@set.Id" class="d-flex gap-2">
                <input name="newVersion" class="form-control form-control-sm" maxlength="@Vr" placeholder="Version of the new revision" required />
                <button type="submit" class="btn btn-ia-outline btn-sm">New revision</button>
            </form>
            @if (set.RetiredAt is null)
            {
                <form method="post" asp-page-handler="Retire" asp-route-id="@set.Id">
                    <button type="submit" class="btn btn-link btn-sm text-danger">Retire this set</button>
                </form>
            }
        </div>
    </div>

    @foreach (var assembly in set.Assemblies.OrderBy(a => a.Position))
    {
        <div class="feature-card mb-3" id="a-@assembly.Id">
            @if (Model.Editable)
            {
                <form method="post" asp-page-handler="SaveAssembly" asp-route-id="@set.Id" class="row g-2 mb-2">
                    <input type="hidden" name="assemblyId" value="@assembly.Id" />
                    <div class="col-md-3"><label class="form-label small">Assembly</label><input name="name" value="@assembly.Name" class="form-control form-control-sm" maxlength="@Nm" required /></div>
                    <div class="col-md-2"><label class="form-label small">Version</label><input name="version" value="@assembly.Version" class="form-control form-control-sm" maxlength="@Vr" required /></div>
                    <div class="col-md-2"><label class="form-label small">Part number</label><input name="partNumber" value="@assembly.PartNumber" class="form-control form-control-sm" maxlength="@Pn" /></div>
                    <div class="col-md-1"><label class="form-label small">Count</label><input name="count" type="number" min="1" max="@ElectrodeSetService.MaxAssemblyCount" value="@assembly.Count" class="form-control form-control-sm" required /></div>
                    <div class="col-md-4"><label class="form-label small">Description</label><input name="description" value="@assembly.Description" class="form-control form-control-sm" maxlength="@Ds" /></div>
                    <div class="col-12">
                        <button type="submit" class="btn btn-ia-outline btn-sm">Save assembly</button>
                        <button type="submit" asp-page-handler="RemoveAssembly" asp-route-id="@set.Id" formnovalidate class="btn btn-link btn-sm text-danger">Remove assembly</button>
                    </div>
                </form>
            }
            else
            {
                <div class="d-flex flex-wrap gap-3 align-items-baseline mb-2">
                    <span class="fw-semibold">@assembly.Name @assembly.Version</span>
                    <span>&times; @assembly.Count</span>
                    @if (assembly.PartNumber is not null) { <span class="font-monospace small">@assembly.PartNumber</span> }
                    @if (assembly.Description is not null) { <span class="text-muted small">@assembly.Description</span> }
                </div>
            }

            <table class="table table-sm align-middle mb-0">
                <thead><tr><th>Part</th><th>Version</th><th>Part number</th><th>Count</th><th>Total</th><th>Description</th>@if (Model.Editable) { <th></th> }</tr></thead>
                <tbody>
                @foreach (var part in assembly.Parts.OrderBy(p => p.Position))
                {
                    if (Model.Editable)
                    {
                        <tr>
                            <td colspan="7">
                                <form method="post" asp-page-handler="SavePart" asp-route-id="@set.Id" class="row g-1">
                                    <input type="hidden" name="partId" value="@part.Id" />
                                    <div class="col-md-3"><input name="name" value="@part.Name" class="form-control form-control-sm" maxlength="@Nm" required /></div>
                                    <div class="col-md-1"><input name="version" value="@part.Version" class="form-control form-control-sm" maxlength="@Vr" required /></div>
                                    <div class="col-md-2"><input name="partNumber" value="@part.PartNumber" class="form-control form-control-sm" maxlength="@Pn" /></div>
                                    <div class="col-md-1"><input name="count" type="number" min="1" max="@ElectrodeSetService.MaxPartCount" value="@part.Count" class="form-control form-control-sm" required /></div>
                                    <div class="col-md-3"><input name="description" value="@part.Description" class="form-control form-control-sm" maxlength="@Ds" /></div>
                                    <div class="col-md-2 text-end">
                                        <button type="submit" class="btn btn-link btn-sm">Save</button>
                                        <button type="submit" asp-page-handler="RemovePart" asp-route-id="@set.Id" formnovalidate class="btn btn-link btn-sm text-danger">Remove</button>
                                    </div>
                                </form>
                            </td>
                        </tr>
                    }
                    else
                    {
                        <tr>
                            <td>@part.Name</td><td>@part.Version</td><td class="font-monospace">@part.PartNumber</td>
                            <td>@part.Count</td><td>@(part.Count * assembly.Count)</td><td class="text-muted small">@part.Description</td>
                        </tr>
                    }
                }
                </tbody>
            </table>

            @if (Model.Editable)
            {
                <form method="post" asp-page-handler="DuplicateAssembly" asp-route-id="@set.Id" class="d-flex gap-2 mt-3 pt-2 border-top">
                    <input type="hidden" name="assemblyId" value="@assembly.Id" />
                    <input name="newName" value="@assembly.Name (copy)" class="form-control form-control-sm" maxlength="@Nm" required
                           aria-label="Name of the duplicate" />
                    <button type="submit" class="btn btn-ia-outline btn-sm text-nowrap">Duplicate this assembly</button>
                </form>
            }
            @if (Model.Editable)
            {
                <form method="post" asp-page-handler="AddPart" asp-route-id="@set.Id" class="row g-1 mt-2">
                    <input type="hidden" name="assemblyId" value="@assembly.Id" />
                    <div class="col-md-3"><input name="name" class="form-control form-control-sm" maxlength="@Nm" placeholder="New part: name" required /></div>
                    <div class="col-md-1"><input name="version" class="form-control form-control-sm" maxlength="@Vr" placeholder="Version" required /></div>
                    <div class="col-md-2"><input name="partNumber" class="form-control form-control-sm" maxlength="@Pn" placeholder="Part number" /></div>
                    <div class="col-md-1"><input name="count" type="number" min="1" max="@ElectrodeSetService.MaxPartCount" value="1" class="form-control form-control-sm" required /></div>
                    <div class="col-md-3"><input name="description" class="form-control form-control-sm" maxlength="@Ds" placeholder="Description" /></div>
                    <div class="col-md-2 text-end"><button type="submit" class="btn btn-ia-outline btn-sm">Add part</button></div>
                </form>
            }
        </div>
    }

    @if (Model.Editable)
    {
        <div class="feature-card mb-3">
            <form method="post" asp-page-handler="AddAssembly" asp-route-id="@set.Id" class="row g-2">
                <div class="col-md-3"><label class="form-label small">New assembly</label><input name="name" class="form-control form-control-sm" maxlength="@Nm" required /></div>
                <div class="col-md-2"><label class="form-label small">Version</label><input name="version" class="form-control form-control-sm" maxlength="@Vr" required /></div>
                <div class="col-md-2"><label class="form-label small">Part number</label><input name="partNumber" class="form-control form-control-sm" maxlength="@Pn" /></div>
                <div class="col-md-1"><label class="form-label small">Count</label><input name="count" type="number" min="1" max="@ElectrodeSetService.MaxAssemblyCount" value="1" class="form-control form-control-sm" required /></div>
                <div class="col-md-4"><label class="form-label small">Description</label><input name="description" class="form-control form-control-sm" maxlength="@Ds" /></div>
                <div class="col-12"><button type="submit" class="btn btn-ia-outline btn-sm">Add assembly</button></div>
            </form>
            @if (Model.CopySources.Count > 0)
            {
                <form method="post" asp-page-handler="CopyAssembly" asp-route-id="@set.Id" class="d-flex gap-2 mt-3">
                    <select name="sourceAssemblyId" class="form-select form-select-sm">
                        @foreach (var (id, label) in Model.CopySources) { <option value="@id">@label</option> }
                    </select>
                    <button type="submit" class="btn btn-ia-outline btn-sm text-nowrap">Copy assembly here</button>
                </form>
            }
        </div>
    }
}

<p class="mt-3"><a asp-page="/Manufacturing/ElectrodeSets">&larr; Back to electrode sets</a></p>
