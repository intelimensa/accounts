@page
@model Intelimensa.Accounts.Pages.Manufacturing.UnitsModel
@using Intelimensa.Accounts.Manufacturing
@using Intelimensa.Accounts.Models
@using Intelimensa.Accounts.Pages.Manufacturing
@{
    ViewData["Title"] = "Manufacturing: Units";
}

<h1 class="h3 mb-3">Units</h1>
<partial name="_Results" model="Model" />

<form method="get" class="row g-2 align-items-end mb-3">
    <div class="col-sm-4 col-md-3">
        <label class="form-label small" for="f-done">Step done</label>
        <select id="f-done" name="done" class="form-select form-select-sm">
            <option value="">(any)</option>
            @foreach (var step in ProductionChecklist.Steps)
            {
                <option value="@step" selected="@(Model.Done == step)">@ProductionChecklist.Title(step)</option>
            }
        </select>
    </div>
    <div class="col-sm-4 col-md-3">
        <label class="form-label small" for="f-notdone">Step not done</label>
        <select id="f-notdone" name="notDone" class="form-select form-select-sm">
            <option value="">(any)</option>
            @foreach (var step in ProductionChecklist.Steps)
            {
                <option value="@step" selected="@(Model.NotDone == step)">@ProductionChecklist.Title(step)</option>
            }
        </select>
    </div>
    <div class="col-auto form-check ms-2">
        <input id="f-all" type="checkbox" name="all" value="true" class="form-check-input" checked="@Model.All" />
        <label class="form-check-label small" for="f-all">Include units not issued here</label>
    </div>
    <div class="col-auto"><button type="submit" class="btn btn-ia-outline btn-sm">Filter</button></div>
</form>

<div class="feature-card">
    @if (!Model.Units.Any())
    {
        <p class="text-muted mb-0">No units reserved yet.</p>
    }
    else
    {
        <table class="table table-sm align-middle mb-0">
            <thead>
                <tr><th>Serial</th><th>Type</th><th>Status</th><th>Firmware</th><th>Bootloader</th><th>Checklist</th><th></th></tr>
            </thead>
            <tbody>
            @foreach (var unit in Model.Units)
            {
                <tr>
                    <td class="font-monospace">@unit.SerialLabel</td>
                    <td>@unit.DeviceType.ToUpperInvariant()</td>
                    <td><span class="badge text-bg-secondary">@(unit.Held ? "Held (no code)" : unit.Status.ToString())</span></td>
                    <td>@(unit.FirmwareVersion ?? "-")</td>
                    <td>@(unit.BootloaderVersion ?? "-")</td>
                    <td>
                        <a asp-page="/Manufacturing/Unit" asp-route-serial="@unit.Serial" class="text-decoration-none">
                            @foreach (var step in ProductionChecklist.Steps)
                            {
                                var done = unit.DoneSteps.Contains(step);
                                <span title="@ProductionChecklist.Title(step): @(done ? "done" : "not done")" class="@(done ? "text-success" : "text-muted")">@(done ? "●" : "○")</span>
                            }
                        </a>
                    </td>
                    <td class="text-end">
                        @if (unit.Status == BciDeviceStatus.Reserved)
                        {
                            <form method="post" asp-page-handler="Void" class="d-inline">
                                <input type="hidden" name="serialNumber" value="@unit.SerialLabel" />
                                <button type="submit" class="btn btn-link btn-sm text-danger">Void</button>
                            </form>
                        }
                    </td>
                </tr>
            }
            </tbody>
        </table>
    }
</div>

<p class="mt-3"><a asp-page="/Manufacturing/Index">&larr; Back to manufacturing</a></p>
