@page
@model Intelimensa.Accounts.Pages.Manufacturing.MountingTypesModel
@using Intelimensa.Accounts.Manufacturing
@{
    ViewData["Title"] = "Manufacturing: Mounting clips";
}

<h1 class="h3 mb-3">Mounting clips</h1>
<partial name="_ProductionMessages" model="Model" />

<p class="text-muted small">
    The clip types a unit can be assigned in the checklist's "Mounting assigned" step. A type is never deleted: retiring it
    keeps it on the units that carry it, and it can't be picked again.
</p>

<div class="feature-card mb-4">
    <form method="post" asp-page-handler="Add" class="row g-2">
        <div class="col-sm-6">
            <label class="form-label" for="m-name">New mounting clip type</label>
            <input id="m-name" name="displayName" class="form-control" maxlength="@MountingTypeService.MaxNameLength" required />
        </div>
        <div class="col-sm-3 align-self-end"><button type="submit" class="btn btn-ia-outline">Add</button></div>
    </form>
</div>

<div class="feature-card">
    @if (Model.Types.Count == 0)
    {
        <p class="text-muted mb-0">No mounting clip types yet.</p>
    }
    else
    {
        <table class="table table-sm align-middle mb-0">
            <thead><tr><th>Name</th><th>Units</th><th></th></tr></thead>
            <tbody>
            @foreach (var type in Model.Types)
            {
                <tr class="@(type.RetiredAt is null ? "" : "text-muted")">
                    <td>
                        @if (type.RetiredAt is null)
                        {
                            <form method="post" asp-page-handler="Rename" class="d-flex gap-2">
                                <input type="hidden" name="id" value="@type.Id" />
                                <input name="displayName" value="@type.DisplayName" class="form-control form-control-sm" maxlength="@MountingTypeService.MaxNameLength" />
                                <button type="submit" class="btn btn-link btn-sm">Rename</button>
                            </form>
                        }
                        else
                        {
                            <span>@type.DisplayName</span> <span class="badge text-bg-secondary">retired</span>
                        }
                    </td>
                    <td>@Model.Units.GetValueOrDefault(type.Id)</td>
                    <td class="text-end">
                        @if (type.RetiredAt is null)
                        {
                            <form method="post" asp-page-handler="Retire" class="d-inline">
                                <input type="hidden" name="id" value="@type.Id" />
                                <button type="submit" class="btn btn-link btn-sm text-danger">Retire</button>
                            </form>
                        }
                    </td>
                </tr>
            }
            </tbody>
        </table>
    }
</div>

<p class="mt-3"><a asp-page="/Manufacturing/Index">&larr; Back to manufacturing</a></p>
