@page
@model Intelimensa.Accounts.Pages.Manufacturing.ElectrodeSetsModel
@using Intelimensa.Accounts.Manufacturing
@using Intelimensa.Accounts.Pages.Manufacturing
@{
    ViewData["Title"] = "Manufacturing: Electrode sets";
}

<h1 class="h3 mb-3">Electrode sets</h1>
<partial name="_ProductionMessages" model="Model" />

<p class="text-muted small">
    A set is the whole electrode complement of a unit: assemblies made of parts, with counts. Once a set is assigned to a unit
    it is frozen; to change it, make a new revision. Sets are never deleted, only retired.
</p>

<div class="feature-card mb-4">
    <form method="post" asp-page-handler="Create" class="row g-2">
        <div class="col-sm-5">
            <label class="form-label" for="s-name">New set: name</label>
            <input id="s-name" name="name" class="form-control" maxlength="@ElectrodeSetService.MaxNameLength" required />
        </div>
        <div class="col-sm-3">
            <label class="form-label" for="s-version">Version</label>
            <input id="s-version" name="version" class="form-control" maxlength="@ElectrodeSetService.MaxVersionLength" required />
        </div>
        <div class="col-12">
            <label class="form-label" for="s-desc">Description <span class="text-muted">(opt.)</span></label>
            <input id="s-desc" name="description" class="form-control" maxlength="@ElectrodeSetService.MaxSetDescriptionLength" />
        </div>
        <div class="col-12"><button type="submit" class="btn btn-ia-outline">Create and edit</button></div>
    </form>
</div>

<div class="feature-card">
    @if (Model.Rows.Count == 0)
    {
        <p class="text-muted mb-0">No electrode sets yet.</p>
    }
    else
    {
        <table class="table table-sm align-middle mb-0">
            <thead><tr><th>Name</th><th>Version</th><th>Assemblies</th><th>Units</th><th>Last modified</th><th></th></tr></thead>
            <tbody>
            @foreach (var row in Model.Rows)
            {
                var set = row.Set;
                <tr class="@(set.RetiredAt is null ? "" : "text-muted")">
                    <td><a asp-page="/Manufacturing/ElectrodeSet" asp-route-id="@set.Id">@set.Name</a></td>
                    <td>@set.Version
                        @if (set.RetiredAt is not null) { <span class="badge text-bg-secondary">retired</span> }
                        else if (set.FrozenAt is not null) { <span class="badge text-bg-info">frozen</span> }
                    </td>
                    <td>@row.Assemblies</td>
                    <td>@row.Units</td>
                    <td class="small">@ProductionPageModel.When(set.LastModifiedAt)<br />@ProductionPageModel.Who(Model.Emails, set.LastModifiedByUserId)</td>
                    <td class="text-end"><a asp-page="/Manufacturing/ElectrodeSet" asp-route-id="@set.Id" class="btn btn-link btn-sm">Open</a></td>
                </tr>
            }
            </tbody>
        </table>
    }
</div>

<p class="mt-3"><a asp-page="/Manufacturing/Index">&larr; Back to manufacturing</a></p>
