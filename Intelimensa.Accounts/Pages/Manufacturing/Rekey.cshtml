@page
@model Intelimensa.Accounts.Pages.Manufacturing.RekeyModel
@using Intelimensa.Accounts.Models
@using Intelimensa.Accounts.Pages.Manufacturing
@{
    ViewData["Title"] = "Manufacturing: Rekey a unit";
}

<h1 class="h3 mb-3">Rekey a unit</h1>
<partial name="_Results" model="Model" />

<div class="feature-card mb-4">
    <p class="text-muted small">
        Issues a new registration code for the same serial. The old code stops working at once and
        the unit goes back to Reserved until it is re-flashed and confirmed. Participants already
        paired are unaffected. For a <strong>held</strong> serial this issues its first code (the
        reason is recorded as Initial whatever you pick).
    </p>
    <form method="post" class="row g-2">
        <div class="col-sm-6">
            <label class="form-label" for="k-serial">Serial</label>
            <input id="k-serial" name="serialNumber" class="form-control font-monospace" required />
        </div>
        <div class="col-sm-6">
            <label class="form-label" for="k-reason">Reason</label>
            <select id="k-reason" name="reason" class="form-select">
                @foreach (var reason in Model.RekeyReasons)
                {
                    <option value="@reason">@reason</option>
                }
            </select>
        </div>
        <div class="col-sm-6">
            <partial name="_BuildSelect" model='new BuildSelectModel("k-fw", "Intended firmware build", Model.Builds)' />
        </div>
        <div class="col-12">
            <label class="form-label" for="k-note">Note <span class="text-muted">(opt.)</span></label>
            <input id="k-note" name="note" class="form-control" maxlength="500" />
        </div>
        <div class="col-12">
            <button type="submit" class="btn btn-ia-outline">Rekey</button>
        </div>
    </form>
</div>

<p class="mt-3"><a asp-page="/Manufacturing/Index">&larr; Back to manufacturing</a></p>
