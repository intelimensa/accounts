@model Intelimensa.Accounts.Pages.Manufacturing.ProductionPageModel
@if (Model.StatusMessage is not null)
{
    <div class="alert alert-success" role="alert">@Model.StatusMessage</div>
}
@if (Model.WarningMessage is not null)
{
    <div class="alert alert-warning" role="alert">@Model.WarningMessage</div>
}
@if (Model.ErrorMessage is not null)
{
    <div class="alert alert-danger" role="alert">@Model.ErrorMessage</div>
}
