@page
@model Intelimensa.Accounts.Pages.Manufacturing.SerialsModel
@using Intelimensa.Accounts.Models
@using Intelimensa.Accounts.Pages.Manufacturing
@{
    ViewData["Title"] = "Manufacturing: Allocate serials";
}

<h1 class="h3 mb-3">Allocate serials</h1>
<partial name="_Results" model="Model" />

<div class="feature-card mb-4">
    <h2 class="h5 mb-1">Allocate serials in advance</h2>
    <p class="text-muted small">
        Gets new serials to print on casings before the boards are ready. Only the serial is reserved, so
        it can never be issued to another unit: <strong>no registration code and no firmware
        yet</strong>. When you flash the unit, <strong>rekey</strong> it to get its first code, then
        confirm.
    </p>
    <form method="post" asp-page-handler="AllocateSerials" class="row g-2 align-items-end mb-4">
        <div class="col-sm-2">
            <label class="form-label" for="a-type">Device type</label>
            <select id="a-type" name="deviceType" class="form-select">
                @foreach (var type in Model.DeviceTypes)
                {
                    <option value="@type">@type.ToUpperInvariant()</option>
                }
            </select>
        </div>
        <div class="col-sm-2">
            <label class="form-label" for="a-region">Region</label>
            <select id="a-region" name="region" class="form-select">
                @foreach (var region in Model.Regions)
                {
                    <option value="@region">@region</option>
                }
            </select>
        </div>
        <div class="col-sm-2">
            <label class="form-label" for="a-count">Count</label>
            <input id="a-count" name="count" type="number" min="1" max="200" value="1" class="form-control" required />
        </div>
        <div class="col-sm-3">
            <button type="submit" class="btn btn-ia-primary w-100">Allocate serials</button>
        </div>
    </form>

    <h3 class="h6 mb-1">Hold serials you already have</h3>
    <p class="text-muted small">
        For serials that already exist outside the server. Held the same way as above. A serial must be
        valid (its last character is a check character), use a configured product and region, and not
        have been issued before. One per line; dashes are optional.
    </p>
    <form method="post" asp-page-handler="HoldSerials" class="row g-2 align-items-end">
        <div class="col-md-8">
            <label class="form-label" for="s-serials">Serials</label>
            <textarea id="s-serials" name="serials" class="form-control font-monospace" rows="5" required></textarea>
        </div>
        <div class="col-md-4">
            <button type="submit" class="btn btn-ia-primary w-100">Hold serials</button>
        </div>
    </form>
</div>

<p class="mt-3"><a asp-page="/Manufacturing/Index">&larr; Back to manufacturing</a></p>
