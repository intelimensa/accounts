@page
@model Intelimensa.Accounts.Pages.Account.ForgotPasswordModel
@{
    ViewData["Title"] = "Forgot password";
}

<div class="row justify-content-center">
    <div class="col-md-6 col-lg-5">
        <div class="feature-card mt-4">
            <h1 class="h3 mb-3">Forgot password</h1>

            @if (Model.Sent)
            {
                <div class="alert alert-secondary" role="status">
                    If an account exists for that address, we've sent a link to choose a new password. It works for
                    one hour. Check your spam folder if it doesn't arrive.
                </div>
                <p class="mb-0"><a asp-page="/Account/Login">Back to sign in</a></p>
            }
            else
            {
                <p>Enter the email address of your account and we'll send you a link to choose a new password.</p>
                <form method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
                    <div class="mb-3">
                        <label asp-for="Input.Email" class="form-label"></label>
                        <input asp-for="Input.Email" class="form-control" autocomplete="username" />
                        <span asp-validation-for="Input.Email" class="text-danger"></span>
                    </div>
                    <button type="submit" class="btn btn-ia-primary w-100">Send reset link</button>
                </form>
                <p class="mt-3 mb-0 text-center"><a asp-page="/Account/Login">Back to sign in</a></p>
            }
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
