@page
@model Intelimensa.Accounts.Pages.Account.StatusModel
@{
    ViewData["Title"] = "My Account";
}

<div class="row justify-content-center">
    <div class="col-md-7">
        <div class="feature-card mt-4">
            <h1 class="h3 mb-3">My Account</h1>
            <dl class="row mb-0">
                <dt class="col-sm-4">Email</dt>
                <dd class="col-sm-8">@Model.Email</dd>

                <dt class="col-sm-4">Status</dt>
                <dd class="col-sm-8">@(Model.Account?.Status.ToString() ?? "Unknown")</dd>

                <dt class="col-sm-4">Expires</dt>
                <dd class="col-sm-8">
                    @(Model.Account?.ExpiresAt is { } expiresAt ? expiresAt.ToString("yyyy-MM-dd") : "No expiry set")
                </dd>

                <dt class="col-sm-4">Assigned configuration</dt>
                <dd class="col-sm-8 mb-0">@(Model.AssignedConfigName ?? "Not yet assigned")</dd>
            </dl>
        </div>
    </div>
</div>
