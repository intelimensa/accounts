@page
@model Intelimensa.Accounts.Pages.Account.StatusModel
@{
    ViewData["Title"] = "My Account";
}

<div class="row justify-content-center">
    <div class="col-md-7">
        <div class="feature-card mt-4">
            <h1 class="h3 mb-3">My Account</h1>
            @if (Model.Message is not null)
            {
                <div class="alert alert-secondary" role="status">@Model.Message</div>
            }
            @if (!Model.EmailConfirmed)
            {
                <div class="alert alert-warning" role="alert">
                    <p class="mb-2">Please confirm your email address: we sent a link to <strong>@Model.Email</strong>.
                       Our team can only approve your account once it is confirmed.</p>
                    <form method="post" asp-page-handler="Resend" class="mb-0">
                        <button type="submit" class="btn btn-outline-secondary btn-sm">Send the email again</button>
                    </form>
                </div>
            }
            else if (Model.Account?.Status == Intelimensa.Accounts.Models.AccountStatus.Pending)
            {
                <div class="alert alert-info" role="alert">
                    Your account is awaiting approval by the Intelimensa team. Downloads and sign-in from
                    AxoSync become available once it is approved.
                </div>
            }
            <dl class="row mb-0">
                <dt class="col-sm-4">Email</dt>
                <dd class="col-sm-8">@Model.Email</dd>

                <dt class="col-sm-4">Status</dt>
                <dd class="col-sm-8">@(Model.Account?.Status.ToString() ?? "Unknown")</dd>

                <dt class="col-sm-4">Expires</dt>
                <dd class="col-sm-8">
                    @(Model.Account?.ExpiresAt is { } expiresAt ? expiresAt.ToString("yyyy-MM-dd") : "No expiry set")
                </dd>

                @if (Model.CanDownload)
                {
                    <dt class="col-sm-4">AxoSync</dt>
                    <dd class="col-sm-8"><a asp-page="/Download">Download the app &rarr;</a></dd>
                }

                <dt class="col-sm-4">Registered devices</dt>
                <dd class="col-sm-8">
                    @if (!Model.Devices.Any())
                    {
                        <span class="text-muted">None yet.</span>
                    }
                    else
                    {
                        <ul class="list-unstyled mb-0">
                            @foreach (var device in Model.Devices)
                            {
                                <li>
                                    <strong>@Intelimensa.Accounts.Manufacturing.SerialNumber.ToDisplay(device.SerialNumber)</strong> (@device.DeviceType) &mdash;
                                    @(device.AssignedConfigName ?? "config not yet assigned")
                                    @if (device.UnassignedAt is not null)
                                    {
                                        <span class="text-danger">(access revoked)</span>
                                    }
                                </li>
                            }
                        </ul>
                    }
                </dd>

                <dt class="col-sm-4">AxoSync installations</dt>
                <dd class="col-sm-8">
                    @if (!Model.Installs.Any())
                    {
                        <span class="text-muted">None signed in.</span>
                    }
                    else
                    {
                        <ul class="list-unstyled mb-0">
                            @foreach (var install in Model.Installs)
                            {
                                <li class="d-flex flex-wrap align-items-center gap-2">
                                    <span>
                                        <strong>@(install.Name ?? install.Platform.ToString())</strong>
                                        <span class="text-muted small">
                                            (@install.Platform@(install.AppVersion is null ? "" : $", AxoSync {install.AppVersion}"),
                                            last used @install.LastActivity.ToString("yyyy-MM-dd"))
                                        </span>
                                    </span>
                                    <form method="post" asp-page-handler="RemoveInstall" class="mb-0"
                                          onsubmit="return confirm('Remove this installation? It is signed out at once.');">
                                        <input type="hidden" name="installId" value="@install.Id" />
                                        <button type="submit" class="btn btn-link btn-sm text-danger p-0">Remove</button>
                                    </form>
                                </li>
                            }
                        </ul>
                    }
                </dd>

                <dt class="col-sm-4">Research study</dt>
                <dd class="col-sm-8 mb-0">
                    @if (Model.StudyParticipation is null)
                    {
                        <span>Not participating.</span>
                    }
                    else if (Model.StudyParticipation.WithdrawnAt is not null)
                    {
                        <span>Withdrawn.</span>
                    }
                    else
                    {
                        <span>Participating since @Model.StudyParticipation.ConsentGivenAt.ToString("yyyy-MM-dd").</span>
                    }
                    <a asp-page="/Account/Study">Manage &rarr;</a>
                </dd>
            </dl>
        </div>
    </div>
</div>
