@page
@model Intelimensa.Accounts.Pages.Account.ChangeEmailModel
@{
    ViewData["Title"] = "Change email";
}

<div class="row justify-content-center">
    <div class="col-md-6 col-lg-5">
        <div class="feature-card mt-4">
            <h1 class="h3 mb-3">Change email</h1>

            @if (Model.SentTo is not null)
            {
                <div class="alert alert-secondary" role="status">
                    If <strong>@Model.SentTo</strong> can be used, we've sent a confirmation link to it. Your email stays
                    <strong>@Model.CurrentEmail</strong> until you open that link.
                </div>
                <p class="mb-0"><a asp-page="/Account/Status">Back to My Account</a></p>
            }
            else
            {
                <p>Your sign-in email is <strong>@Model.CurrentEmail</strong>. We'll send a link to the new address;
                   the change only happens when you open it.</p>
                <form method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
                    <div class="mb-3">
                        <label asp-for="Input.NewEmail" class="form-label"></label>
                        <input asp-for="Input.NewEmail" class="form-control" autocomplete="email" />
                        <span asp-validation-for="Input.NewEmail" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Input.Password" class="form-label"></label>
                        <input asp-for="Input.Password" class="form-control" autocomplete="current-password" />
                        <span asp-validation-for="Input.Password" class="text-danger"></span>
                    </div>
                    <button type="submit" class="btn btn-ia-primary w-100">Send confirmation link</button>
                </form>
                <p class="mt-3 mb-0 text-center"><a asp-page="/Account/Status">Back to My Account</a></p>
            }
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
