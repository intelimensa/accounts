@page
@model Intelimensa.Accounts.Pages.DownloadModel
@{
    ViewData["Title"] = "Download";
}

<div class="text-center mb-4">
    <h1 class="display-6">Download AxoSync</h1>
    <p class="text-muted">
        AxoSync is not publicly available yet. Downloads will appear here once the first
        release ships.
    </p>
</div>

<div class="row g-4">
    @foreach (var platform in Model.Platforms)
    {
        <div class="col-md-6 col-lg-3">
            <div class="feature-card h-100 d-flex flex-column @(platform.Enabled ? "" : "opacity-50")">
                <h2 class="h5">@platform.Name</h2>
                @if (platform.Note is not null)
                {
                    <p class="text-muted small mb-3">@platform.Note</p>
                }

                @if (platform.Enabled)
                {
                    <a class="btn btn-ia-primary mt-auto" href="@platform.Url" title="Placeholder link -- no build artifacts yet">
                        Download
                    </a>
                }
                else
                {
                    <button class="btn btn-ia-primary mt-auto" type="button" disabled aria-disabled="true">
                        Download
                    </button>
                }
            </div>
        </div>
    }
</div>
