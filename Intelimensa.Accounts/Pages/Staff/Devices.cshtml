@page
@model Intelimensa.Accounts.Pages.Staff.DevicesModel
@{
    ViewData["Title"] = "Staff: Devices";
}

<h1 class="h3 mb-3">Devices</h1>
<p class="text-muted">
    The production/inventory list of physical BCI units. New units are created by the manufacturing
    station, which issues each a registration code. Units added on this page are <strong>backfill only</strong>:
    they have no registration code, so they can't be newly registered while code checking is on.
</p>

@if (Model.StatusMessage is not null)
{
    <div class="alert alert-success" role="alert">@Model.StatusMessage</div>
}

@if (Model.ErrorMessage is not null)
{
    <div class="alert alert-danger" role="alert">@Model.ErrorMessage</div>
}

@if (Model.ImportErrors.Count > 0)
{
    <div class="feature-card mb-4">
        <h2 class="h6">Import errors</h2>
        <ul class="mb-0 small">
            @foreach (var error in Model.ImportErrors)
            {
                <li>@(error.Line > 0 ? $"Line {error.Line}: " : "")@error.Message</li>
            }
        </ul>
    </div>
}

<div class="feature-card mb-4">
    <h2 class="h5 mb-3">Add a device</h2>
    <form method="post" asp-page-handler="Create" class="row g-2 align-items-end">
        <div class="col-sm-3">
            <label asp-for="Input.SerialNumber" class="form-label"></label>
            <input asp-for="Input.SerialNumber" class="form-control" />
            <span asp-validation-for="Input.SerialNumber" class="text-danger"></span>
        </div>
        <div class="col-sm-2">
            <label asp-for="Input.DeviceType" class="form-label"></label>
            <input asp-for="Input.DeviceType" class="form-control" placeholder="e.g. msv2" />
            <span asp-validation-for="Input.DeviceType" class="text-danger"></span>
        </div>
        <div class="col-sm-2">
            <label asp-for="Input.ProducedAt" class="form-label"></label>
            <input asp-for="Input.ProducedAt" class="form-control" />
            <span asp-validation-for="Input.ProducedAt" class="text-danger"></span>
        </div>
        <div class="col-sm-3">
            <label asp-for="Input.CurrentFirmwareVersion" class="form-label"></label>
            <input asp-for="Input.CurrentFirmwareVersion" class="form-control" />
            <span asp-validation-for="Input.CurrentFirmwareVersion" class="text-danger"></span>
        </div>
        <div class="col-sm-2">
            <button type="submit" class="btn btn-ia-primary w-100">Add Device</button>
        </div>
    </form>
</div>

<div class="feature-card mb-4">
    <h2 class="h5 mb-2">Import from CSV</h2>
    <p class="text-muted small mb-3">
        Header row required: <code>serial_number,device_type,produced_at,firmware_version</code>
        (<code>produced_at</code> as <code>yyyy-MM-dd</code>). All-or-nothing: if any row is invalid
        or a serial already exists, nothing is imported.
    </p>
    <form method="post" asp-page-handler="Import" enctype="multipart/form-data" class="row g-2 align-items-end">
        <div class="col-sm-10">
            <input type="file" name="csvFile" accept=".csv,text/csv" class="form-control" required />
        </div>
        <div class="col-sm-2">
            <button type="submit" class="btn btn-ia-primary w-100">Import</button>
        </div>
    </form>
</div>

@if (!Model.Devices.Any())
{
    <p class="text-muted">No devices yet.</p>
}

<div class="d-flex flex-column gap-2">
    @foreach (var device in Model.Devices)
    {
        <div class="feature-card d-flex justify-content-between align-items-center">
            <div>
                <strong>@Intelimensa.Accounts.Manufacturing.SerialNumber.ToDisplay(device.SerialNumber)</strong>
                <span class="badge @(device.Status == Intelimensa.Accounts.Models.BciDeviceStatus.Manufactured ? "text-bg-success" : "text-bg-warning")">@device.Status</span>
                @if (!device.HasRegistrationCode)
                {
                    <span class="badge text-bg-secondary">no code</span>
                }
                <div class="text-muted small">
                    Type: @device.DeviceType &middot; Produced @device.ProducedAt.ToString("yyyy-MM-dd")
                    &middot; Firmware @device.CurrentFirmwareVersion
                    @if (device.BootloaderVersion is not null)
                    {
                        <text> &middot; Bootloader @device.BootloaderVersion</text>
                    }
                    @if (device.LastFirmwareUpdatedAt is { } updatedAt)
                    {
                        <text> (updated @updatedAt.ToString("yyyy-MM-dd"))</text>
                    }
                </div>
            </div>
            <div class="text-muted small">@device.RegistrationCount registered</div>
        </div>
    }
</div>

<p class="mt-3"><a asp-page="/Staff/Index">&larr; Back to accounts</a></p>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
