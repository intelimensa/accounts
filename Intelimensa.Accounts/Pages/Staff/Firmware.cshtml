@page
@model Intelimensa.Accounts.Pages.Staff.FirmwareModel
@using Intelimensa.Accounts.Models
@{
    ViewData["Title"] = "Staff: Firmware";
}

<h1 class="h3 mb-3">Firmware</h1>
<p class="text-muted">
    Production-ready hex builds the manufacturing station can flash. Only <strong>Published</strong>
    builds are listed to the station. Builds are immutable: ship a fix as a new version.
</p>

@if (Model.StatusMessage is not null)
{
    <div class="alert alert-success" role="alert">@Model.StatusMessage</div>
}
@if (Model.ErrorMessage is not null)
{
    <div class="alert alert-danger" role="alert">@Model.ErrorMessage</div>
}

<div class="feature-card mb-4">
    <h2 class="h5 mb-3">Upload a build</h2>
    <form method="post" asp-page-handler="Upload" enctype="multipart/form-data" class="row g-2 align-items-end">
        <div class="col-sm-2">
            <label asp-for="Input.DeviceType" class="form-label">Device type</label>
            <select asp-for="Input.DeviceType" class="form-select">
                @foreach (var type in Model.DeviceTypes)
                {
                    <option value="@type">@type.ToUpperInvariant()</option>
                }
            </select>
        </div>
        <div class="col-sm-2">
            <label asp-for="Input.Kind" class="form-label"></label>
            <select asp-for="Input.Kind" class="form-select">
                <option value="@FirmwareKind.Application">Application</option>
                <option value="@FirmwareKind.Bootloader">Bootloader (MS-V3)</option>
            </select>
        </div>
        <div class="col-sm-2">
            <label asp-for="Input.Version" class="form-label"></label>
            <input asp-for="Input.Version" class="form-control" />
            <span asp-validation-for="Input.Version" class="text-danger"></span>
        </div>
        <div class="col-sm-3">
            <label asp-for="Input.File" class="form-label">Hex file</label>
            <input asp-for="Input.File" type="file" accept=".hex" class="form-control" required />
        </div>
        <div class="col-sm-3">
            <button type="submit" class="btn btn-ia-primary w-100">Upload Draft</button>
        </div>
        <div class="col-12">
            <label asp-for="Input.Notes" class="form-label"></label>
            <input asp-for="Input.Notes" class="form-control" />
        </div>
    </form>
</div>

@if (!Model.Builds.Any())
{
    <p class="text-muted">No firmware builds yet.</p>
}
else
{
    <div class="feature-card">
        <table class="table table-sm align-middle mb-0">
            <thead>
                <tr><th>Type</th><th>Kind</th><th>Version</th><th>Status</th><th>File</th><th></th></tr>
            </thead>
            <tbody>
            @foreach (var build in Model.Builds)
            {
                <tr>
                    <td>@build.DeviceType.ToUpperInvariant()</td>
                    <td>@build.Kind</td>
                    <td>
                        @build.Version
                        @if (build.Notes is not null)
                        {
                            <div class="text-muted small">@build.Notes</div>
                        }
                    </td>
                    <td><span class="badge text-bg-secondary">@build.Status</span></td>
                    <td class="small">
                        @build.FileName &middot; @(build.SizeBytes / 1024) KB
                        <div class="text-muted text-break">SHA-256 @build.Sha256</div>
                    </td>
                    <td class="text-end text-nowrap">
                        <form method="post" asp-page-handler="SetStatus" class="d-inline">
                            <input type="hidden" name="buildId" value="@build.Id" />
                            @if (build.Status != FirmwareBuildStatus.Published)
                            {
                                <button type="submit" name="status" value="@FirmwareBuildStatus.Published" class="btn btn-ia-primary btn-sm">Publish</button>
                            }
                            else
                            {
                                <button type="submit" name="status" value="@FirmwareBuildStatus.Withdrawn" class="btn btn-ia-outline btn-sm">Withdraw</button>
                            }
                        </form>
                        @if (build.Status == FirmwareBuildStatus.Draft)
                        {
                            <form method="post" asp-page-handler="Delete" class="d-inline">
                                <input type="hidden" name="buildId" value="@build.Id" />
                                <button type="submit" class="btn btn-link btn-sm text-danger">Delete</button>
                            </form>
                        }
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}

<p class="mt-3"><a asp-page="/Staff/Index">&larr; Back to accounts</a></p>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
