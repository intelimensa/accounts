@page
@model Intelimensa.Accounts.Pages.Staff.PurgeReleaseModel
@using Intelimensa.Accounts.Models
@using Intelimensa.Accounts.ServerInfo
@{
    ViewData["Title"] = "Staff: Purge release";
    var release = Model.Release!;
    var canPurge = release.Status == ReleaseStatus.Withdrawn && release.Artifacts.Count > 0;
}

<h1 class="h3 mb-3">Purge release v@(release.Version)</h1>

@if (Model.ErrorMessage is not null)
{
    <div class="alert alert-danger" role="alert">@Model.ErrorMessage</div>
}

@if (!canPurge)
{
    <div class="alert alert-warning" role="alert">
        @(release.Status != ReleaseStatus.Withdrawn
            ? "Only a withdrawn release can be purged. Withdraw it first."
            : "This release has no files left.")
    </div>
}
else
{
    <div class="feature-card border-danger mb-3">
        <p>
            This permanently deletes the installers of <strong>v@(release.Version)</strong> from the server and frees
            <strong>@ByteSize.Format(Model.TotalBytes)</strong>. It can't be undone.
        </p>
        <table class="table table-sm align-middle">
            <thead><tr><th>Platform</th><th>File</th><th class="text-end">Size</th><th>Config delivery</th></tr></thead>
            <tbody>
            @foreach (var artifact in release.Artifacts.OrderBy(a => a.Platform))
            {
                <tr>
                    <td>@artifact.Platform.DisplayName()</td>
                    <td class="font-monospace small">@artifact.FileName</td>
                    <td class="text-end">@ByteSize.Format(artifact.SizeBytes)</td>
                    <td>@(artifact.WrappedReleaseSecret is null ? "none" : artifact.ConfigDeliveryBlockedAt is null ? "allowed (will stop)" : "blocked")</td>
                </tr>
            }
            </tbody>
        </table>
        <ul class="small">
            <li>The release itself stays as history, marked <em>files purged</em>. Its version number can't be reused.</li>
            <li>The signatures and release secrets go with the files, so this build can't be restored and gets no more configs.</li>
            <li>Anyone still running it keeps running it, but can't download it again.</li>
        </ul>
        <form method="post" class="row g-2 align-items-end">
            <div class="col-sm-5">
                <label class="form-label" for="confirm">Type <code>@release.Version</code> to confirm</label>
                <input id="confirm" asp-for="ConfirmVersion" class="form-control font-monospace" autocomplete="off" required />
            </div>
            <div class="col-auto">
                <button type="submit" class="btn btn-danger">Purge files</button>
                <a asp-page="/Staff/Releases" class="btn btn-ia-outline">Cancel</a>
            </div>
        </form>
    </div>
}

<p class="mt-3"><a asp-page="/Staff/Releases">&larr; Back to releases</a></p>
