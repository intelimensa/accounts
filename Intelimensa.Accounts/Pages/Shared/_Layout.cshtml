<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Intelimensa Accounts</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Intelimensa.Accounts.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="site-header navbar navbar-expand-sm navbar-toggleable-sm mb-3">
            <div class="container">
                <a class="navbar-brand d-flex align-items-center gap-2" asp-area="" asp-page="/Index">
                    <img src="~/ilogo-b.png" alt="Intelimensa" class="brand-logo brand-logo-light" />
                    <img src="~/ilogo-w.png" alt="Intelimensa" class="brand-logo brand-logo-dark" />
                    <span class="brand-suffix">Accounts</span>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-page="/Index">@Icon("home")<span>Home</span></a>
                        </li>
                        @if (await Access.IsUsableAsync(User))
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-page="/Download">@Icon("download")<span>Downloads</span></a>
                            </li>
                        }
                        @if (User.IsInRole("Manufacturer"))
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-page="/Manufacturing/Index">@Icon("chip")<span>Manufacturing</span></a>
                            </li>
                        }
                        @if (User.IsInRole("Administrator"))
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-page="/Admin/Index">@Icon("shield")<span>Admin</span></a>
                            </li>
                        }
                        @if (User.IsInRole("Staff"))
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-page="/Staff/Index">@Icon("people")<span>Staff</span></a>
                            </li>
                        }
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-page="/Privacy">@Icon("lock")<span>Privacy</span></a>
                        </li>
                    </ul>
                    <ul class="navbar-nav">
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-page="/Account/Status">@Icon("person")<span>My Account</span></a>
                            </li>
                            <li class="nav-item">
                                <form method="post" asp-page="/Account/Logout">
                                    <button type="submit" class="nav-link btn btn-link">@Icon("signout")<span>Sign Out</span></button>
                                </form>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-page="/Account/Login">@Icon("signin")<span>Sign In</span></a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="site-footer border-top footer">
        <div class="container">
            &copy; 2026 - Intelimensa Accounts - <a asp-area="" asp-page="/Privacy">Privacy</a>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
